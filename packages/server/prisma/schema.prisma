datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

generator client {
  provider = "prisma-client-js"
}

model Guild {
  id        String        @id
  name      String
  icon      String?
  ownerId   String?
  joinedAt  DateTime      @default(now())
  settings  GuildSetting?
  cards     Card[]
}

model GuildSetting {
  id                     String   @id @default(uuid())
  guildId                String   @unique
  guild                  Guild    @relation(fields: [guildId], references: [id], onDelete: Cascade)
  prefix                 String   @default("!")
  autoReplyEnabled       Boolean  @default(true)
  defaultReplyMode       String   @default("BOTH") // "TEXT_ONLY", "PHOTO_ONLY", "BOTH"
  deliveryMethod         String   @default("PUBLIC") // "PUBLIC", "EPHEMERAL_REVEAL", "DM"
  allowedChannelIds      String   @default("[]") // JSON stringified array of channel IDs
  allowedCategoryIds     String   @default("[]") // JSON stringified array of category IDs
  ignoredChannelIds      String   @default("[]") // JSON stringified array of channel IDs
  userCooldownSeconds    Int      @default(3) // Rate limit per user
  channelCooldownSeconds Int      @default(1)
  autoDeleteSeconds      Int      @default(0) // 0 = disabled, > 0 = delete bot reply after X seconds
  allowDms               Boolean  @default(true)
  createdAt              DateTime @default(now())
  updatedAt              DateTime @updatedAt
}

model Card {
  id               String   @id @default(uuid())
  guildId          String?  // null if official global card, guildId if custom server card
  guild            Guild?   @relation(fields: [guildId], references: [id], onDelete: Cascade)
  name             String
  slug             String
  camp             String   @default("VILLAGEOIS") // "VILLAGEOIS", "LOUPS", "SOLITAIRE"
  description      String
  shortDescription String?
  imageUrl         String?
  isUnique         Boolean  @default(true)
  abilityType      String   @default("NIGHT") // "NIGHT", "DAY", "NONE"
  difficulty       Int      @default(1) // 1 to 5 stars
  replyMode        String?  // null inherits guild default, or "TEXT_ONLY", "PHOTO_ONLY", "BOTH"
  isEnabled        Boolean  @default(true)
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt

  @@index([slug])
  @@index([guildId])
}

model AllowedGuild {
  id        String   @id // Discord Guild ID
  name      String
  icon      String?
  addedBy   String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model SuperAdmin {
  id        String   @id // Discord User ID
  username  String
  avatar    String?
  addedBy   String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}
